{
  "version": 1,
  "commit": "61f359163e088a1171ae0e7a6cdaad2e4262a2b0",
  "plugins": [
    {
      "id": "time-in-state",
      "name": "Time in state",
      "version": "1.0.0",
      "description": "Shows how long each terminal has been waiting on you or working, in its sidebar row and pane header.",
      "author": "Otterm",
      "api": 1,
      "main": "main.js",
      "styles": [
        "styles.css"
      ],
      "where": [
        "window",
        "remote"
      ],
      "permissions": [],
      "settings": [
        {
          "key": "which",
          "type": "choice",
          "label": "Show the time for",
          "default": "busy",
          "choices": [
            {
              "value": "waiting",
              "label": "Terminals waiting on you"
            },
            {
              "value": "busy",
              "label": "Terminals waiting on you or working"
            },
            {
              "value": "all",
              "label": "Every running terminal"
            }
          ]
        },
        {
          "key": "where",
          "type": "choice",
          "label": "Show it in",
          "default": "both",
          "choices": [
            {
              "value": "both",
              "label": "Sidebar rows and pane headers"
            },
            {
              "value": "rows",
              "label": "Sidebar rows"
            },
            {
              "value": "headers",
              "label": "Pane headers"
            }
          ]
        },
        {
          "key": "longAfter",
          "type": "number",
          "label": "Mark a wait as long after",
          "default": 10,
          "min": 1,
          "max": 600,
          "unit": "min",
          "help": "A terminal waiting on you this long shows its time in orange. Empty for never."
        }
      ],
      "base": "https://raw.githubusercontent.com/cognikas/otterm-plugins/61f359163e088a1171ae0e7a6cdaad2e4262a2b0/plugins/time-in-state/",
      "files": [
        {
          "path": "README.md",
          "sha256": "129d0e2aae3edecd266853a62ac910d0436549f977e8bfdbc53fd80edb01645f",
          "size": 616
        },
        {
          "path": "main.js",
          "sha256": "390e4fe72a6fb19435768b5938624e0569fa7822c74fc503e7f54cb22254907b",
          "size": 3239
        },
        {
          "path": "otterm-plugin.json",
          "sha256": "ada931bab3f41308a4efbaf7398b2f7d26f00e5aba7e7a5c2b1d3ad1c6a8b2a3",
          "size": 1420
        },
        {
          "path": "styles.css",
          "sha256": "2d63e78426ccceabc346a879ec7a4c19bfd62800a7b6027a7b5220f64fa66b5f",
          "size": 417
        }
      ]
    }
  ]
}
