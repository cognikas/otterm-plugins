{
  "version": 1,
  "commit": "9e432f452e970950696cb4ec7b00ff7169c364ab",
  "plugins": [
    {
      "id": "time-in-state",
      "name": "Time in state",
      "version": "1.0.1",
      "description": "Shows how long each terminal has been waiting on you or working, in its sidebar row and pane header.",
      "author": "Otterm",
      "api": 1,
      "main": "main.js",
      "styles": [
        "styles.css"
      ],
      "where": [
        "window",
        "remote"
      ],
      "permissions": [],
      "settings": [
        {
          "key": "which",
          "type": "choice",
          "label": "Show the time for",
          "default": "busy",
          "choices": [
            {
              "value": "waiting",
              "label": "Terminals waiting on you"
            },
            {
              "value": "busy",
              "label": "Terminals waiting on you or working"
            },
            {
              "value": "all",
              "label": "Every running terminal"
            }
          ]
        },
        {
          "key": "where",
          "type": "choice",
          "label": "Show it in",
          "default": "both",
          "choices": [
            {
              "value": "both",
              "label": "Sidebar rows and pane headers"
            },
            {
              "value": "rows",
              "label": "Sidebar rows"
            },
            {
              "value": "headers",
              "label": "Pane headers"
            }
          ]
        },
        {
          "key": "longAfter",
          "type": "number",
          "label": "Mark a wait as long after",
          "default": 10,
          "min": 1,
          "max": 600,
          "unit": "min",
          "help": "A terminal waiting on you this long shows its time in orange. Empty for never."
        }
      ],
      "base": "https://raw.githubusercontent.com/cognikas/otterm-plugins/9e432f452e970950696cb4ec7b00ff7169c364ab/plugins/time-in-state/",
      "files": [
        {
          "path": "README.md",
          "sha256": "129d0e2aae3edecd266853a62ac910d0436549f977e8bfdbc53fd80edb01645f",
          "size": 616
        },
        {
          "path": "main.js",
          "sha256": "25e0daa086b432d56b8560c9c800049290704a2fb8171f0c6d0e3661e37fb9c7",
          "size": 3360
        },
        {
          "path": "otterm-plugin.json",
          "sha256": "2fc209c9caf096875e7562c778078cebc82906b6a61f9b15befdf879e62491d6",
          "size": 1420
        },
        {
          "path": "styles.css",
          "sha256": "2d63e78426ccceabc346a879ec7a4c19bfd62800a7b6027a7b5220f64fa66b5f",
          "size": 417
        }
      ]
    }
  ]
}
